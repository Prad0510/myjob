# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=myjob
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password_here

# Connection Pool Settings
DB_POOL_MIN=1
DB_POOL_MAX=10

# ==============================================================================
# Telegram Notifications
# ==============================================================================
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_or_channel_id

# ==============================================================================
# Job Matching & Pipeline Configuration
# ==============================================================================
# Minimum final matching score (0 to 100) required to trigger a notification
MATCH_THRESHOLD=75

# Scheduler frequency in hours (e.g., 6 = every 6 hours)
SYNC_INTERVAL_HOURS=6

# Path to candidate profile JSON
CANDIDATE_PROFILE_PATH=data/processed/candidate_profile.json

# ==============================================================================
# Logging Configuration
# ==============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/myjob.log
ENABLE_FILE_LOGGING=true


# .env (add/adjust)
NUM_CLUSTERS=10          # for K‑Means
MIN_CLUSTER_SIZE=5      # for HDBSCAN
TOP_N_MATCHES=5